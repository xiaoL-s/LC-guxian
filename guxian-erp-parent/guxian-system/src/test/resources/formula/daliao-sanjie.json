{"vars":[{"name":"总高","sort":1},{"name":"总宽","sort":2},{"name":"数量","sort":3},{"name":"颜色","sort":4,"list":"金属灰色,白色,金色"},{"name":"网子","sort":5,"list":"超清网,正宗304高清网,高清网"},{"name":"加杆","sort":6,"list":"无,全防护,中间两根","default":"无"},{"name":"下固定","sort":7},{"name":"把手","sort":8,"list":"金属把手,普通把手"},{"name":"单价","sort":9,"list":"85"}],"防护杆数量":[{"cond":"总高<=1400","expr":"6"},{"cond":"总高>1400","expr":"8"}],"孔位":[{"cond":"下固定=0","expr":"(总高-40)/3+2"},{"cond":"下固定>0","expr":"(总高-40-下固定)/2+2"}],"型材":{"外框高":[{"expr":"总高-40","mult":"2*数量"}],"外框宽":[{"expr":"总宽-40","mult":"2*数量"}],"横杆":[{"expr":"总宽-40","mult":"2*数量"}],"内扇宽":[{"expr":"外框宽+3","mult":"2*数量"}],"内扇高":[{"expr":"孔位+18","mult":"2*数量"}],"竖杆":[{"expr":"孔位-32","mult":"2*数量","cond":"加杆=中间两根"}]},"纱网":{"上网":[{"w":"外框宽+16","h":"孔位+5","mult":"1*数量"}],"下网":[{"w":"外框宽+16","h":"孔位+5","mult":"1*数量","cond":"下固定=0"},{"w":"外框宽+16","h":"下固定+5","mult":"1*数量","cond":"下固定>0"}],"中网":[{"w":"内扇宽-41","h":"孔位-19","mult":"1*数量","cond":"下固定=0"},{"w":"内扇宽-41","h":"孔位-19","mult":"1*数量","cond":"下固定>0"}]},"面积":[{"cond":"总高*总宽*0.000001<=1","expr":"1*数量"},{"cond":"总高*总宽*0.000001>1","expr":"总高*总宽*0.000001*数量"}],"金额明细":{"基本金额":[{"expr":"单价*面积"}],"总高加价":[{"cond":"总高>1399","expr":"5*面积"},{"cond":"总高>1499","expr":"5*面积"}],"网子加价":[{"cond":"网子!=05黑网","expr":"0*面积"}],"加杆加价":[{"cond":"加杆=全防护","expr":"0*面积"}],"把手加价":[{"cond":"把手=密码把手","expr":"0*数量"}]}}