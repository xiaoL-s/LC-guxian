{"vars":[{"name":"总高","sort":1},{"name":"总宽","sort":2},{"name":"数量","sort":3},{"name":"颜色","sort":4,"list":"金属灰,金属咖,白色,黑金石"},{"name":"网子","sort":5,"list":"超清网,正宗304高清网,高清网,23丝超清网"},{"name":"下固定","sort":6},{"name":"单价","sort":7,"list":"198","default":198},{"name":"加杆","sort":8,"list":"全防护","default":"全防护"},{"name":"把手方向","sort":9,"list":"左,右"},{"name":"金额","sort":10}],"防护杆数量":[{"cond":"总高<=1400","expr":"6"},{"cond":"总高>1400","expr":"8"}],"孔位":[{"cond":"下固定=0","expr":"(总高-40)/3"},{"cond":"下固定>0","expr":"(总高-40-下固定)/2"}],"型材":{"外框高":[{"expr":"总高+1","mult":"2*数量"}],"外框宽":[{"expr":"总宽+1","mult":"2*数量"}],"内框高":[{"expr":"总高-26","mult":"2*数量"}],"内框宽":[{"expr":"总宽-61","mult":"2*数量"}],"内扇高":[{"expr":"总高+44","mult":"1*数量"}],"内扇宽":[{"expr":"总宽-0","mult":"2*数量"}],"防护栏":[{"expr":"总宽-25","mult":"防护杆数量*数量","cond":"加杆=全防护"}],"小短杆":[{"expr":"240","mult":"1*数量","cond":"加杆=全防护"}],"短横杆":[{"expr":"防护栏-200","mult":"1*数量","cond":"加杆=全防护"}],"加杆":[{"expr":"孔位-20","mult":"2*数量","cond":"加杆=中间两根"}]},"纱网":{"中网":[{"w":"内框宽-40","h":"内框高-40","mult":"1*数量"}]},"面积":[{"cond":"总高*总宽*0.000001<=1","expr":"1*数量"},{"cond":"总高*总宽*0.000001>1","expr":"总高*总宽*0.000001*数量"}],"超高":[{"cond":"总高>1399","expr":"jw((总高-1399)/100)*5"}],"金额明细":{"基本金额":[{"expr":"单价*面积"}],"超高加价":[{"expr":"超高*数量","cond":"超高>0,lwxs(总高*总宽*0.000001)<=1"}],"加杆加价":[{"expr":"0*面积","cond":"加杆=全防护"}]}}