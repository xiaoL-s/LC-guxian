.task { padding: 20rpx; background: #f5f7fa; min-height: 100vh; }
.head { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 10rpx; }
.hello { font-size: 32rpx; font-weight: bold; }
.logout { font-size: 26rpx; color: #999; }
.stat-row { margin: 20rpx 0; }
.stat { background: #fff; border-radius: 12rpx; padding: 30rpx; text-align: center; }
.stat .num { display: block; font-size: 48rpx; color: #1989fa; font-weight: bold; }
.stat .lbl { font-size: 24rpx; color: #666; }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.no { font-size: 30rpx; font-weight: bold; }
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; background: #fff7e6; color: #fa8c16; }
.row2 { font-size: 26rpx; color: #555; margin: 6rpx 0; }
.stage { color: #1989fa; }
.empty { text-align: center; color: #999; margin-top: 200rpx; font-size: 28rpx; }
