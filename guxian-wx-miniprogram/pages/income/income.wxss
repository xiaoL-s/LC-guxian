.income-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 30rpx;
  box-sizing: border-box;
}
.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1989fa, #5ac8fa);
  border-radius: 28rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(25, 137, 250, 0.2);
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #1989fa;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-info {
  margin-left: 26rpx;
}
.user-name {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}
.user-post {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.stat-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.stat-card {
  width: 48%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}
.stat-label {
  font-size: 26rpx;
  color: #999;
}
.stat-wage {
  font-size: 52rpx;
  font-weight: 700;
  color: #e64340;
  margin-top: 12rpx;
}
.stat-num-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}
.stat-qty {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
.stat-bad {
  font-size: 22rpx;
  color: #fa5151;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
.empty.err {
  color: #fa5151;
  padding: 40rpx 0 20rpx;
}
.refresh-btn {
  margin-top: 30rpx;
  background: #1989fa;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 16rpx 0;
}
.refresh-btn::after {
  border: none;
}
