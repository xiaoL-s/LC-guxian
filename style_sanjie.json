{"vars": [{"name": "总高"}, {"name": "总宽"}, {"name": "数量"}, {"name": "颜色"}, {"name": "网子"}, {"name": "把手"}, {"name": "加杆"}, {"name": "下固定"}, {"name": "单价"}, {"name": "把手方向"}], "型材": {"加杆": [{"cond": "{加杆=有,下固定=0}", "expr": "总高/3-6-36", "mult": "2*数量"}, {"cond": "{加杆=有,下固定>0}", "expr": "孔位-36", "mult": "2*数量"}], "横杆": [{"expr": "总宽-28", "mult": "2*数量"}], "内扇宽": [{"expr": "总宽-27.5", "mult": "2*数量"}], "内扇高": [{"cond": "下固定=0", "expr": "总高/3-6+13", "mult": "2*数量"}, {"cond": "下固定>0", "expr": "孔位+13", "mult": "2*数量"}], "外框宽": [{"expr": "总宽-28", "mult": "2*数量"}], "外框高": [{"expr": "总高-28", "mult": "2*数量"}], "小短杆": [{"cond": "加杆=全防护", "expr": "孔位-36", "mult": "1*数量"}], "短横杆": [{"cond": "加杆=全防护", "expr": "外框宽-182", "mult": "2*数量"}]}, "孔位": [{"cond": "下固定=0", "expr": "总高/3-6"}, {"cond": "下固定>0", "expr": "(总高-下固定)/2-6"}], "纱网": {"上网": [{"h": "内扇高-10", "w": "内扇宽+15", "mult": "1*数量"}], "下网": [{"h": "内扇高-10", "w": "内扇宽+15", "cond": "下固定=0", "mult": "1*数量"}, {"h": "下固定-5+3", "w": "内扇宽+15", "cond": "下固定>0", "mult": "1*数量"}], "中网": [{"h": "内扇高-35", "w": "内扇宽-36", "mult": "1*数量"}]}, "面积": [{"cond": "总高*总宽*0.000001<=1", "expr": "1*数量"}, {"cond": "总高*总宽*0.000001>1", "expr": "总高*总宽*0.000001*数量"}], "金额明细": {"基本金额": [{"expr": "单价*面积"}], "总高加价": [{"cond": "总高>1399", "expr": "5*面积"}, {"cond": "总高>1499", "expr": "5*面积"}], "把手加价": [{"cond": "把手=一字密码锁", "expr": "5*数量"}]}}
